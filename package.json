{
  "name": "ofd-core",
  "version": "1.0.0",
  "private": true,
  "description": "OFD预览器与渲染引擎",
  "scripts": {
    "build": "node build/build-pdf2ofd.js && node build/build-viewer.js",
    "build:ofd": "node build/build-ofd.js",
    "build:ofd2pdf": "node build/build-ofd2pdf.js",
    "build:pdf2ofd": "node build/build-pdf2ofd.js",
    "build:viewer": "node build/build-viewer.js",
    "build:ofd-npm": "node build/build-ofd-npm.js",
    "build:ofd2pdf-npm": "node build/build-ofd2pdf-npm.js",
    "build:pdf2ofd-npm": "node build/build-pdf2ofd-npm.js",
    "test": "node test/golden.js build/ofd/ofd.js --check && node test/golden.js build/ofd/ofd.min.js --check",
    "prepublishOnly": "node build/build-pdf2ofd-npm.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^5.7.284",
    "sm-crypto": "^0.5.7",
    "terser": "^5.44.0"
  }
}
